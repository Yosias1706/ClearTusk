# Copy to .env and adjust. Every value is optional: without a .env file
# ClearTusk runs against a local SQLite database under data/runtime/.

# --- Core ---
CLEARTUSK_ENVIRONMENT=development
CLEARTUSK_SECRET_KEY=change-me-in-production
CLEARTUSK_LOG_LEVEL=INFO

# --- Database ---
# PostgreSQL (recommended; matches docker-compose and CI)
CLEARTUSK_DATABASE_URL=postgresql+psycopg://cleartusk:cleartusk@localhost:5432/cleartusk
# SQLite fallback:
# CLEARTUSK_DATABASE_URL=sqlite:///data/runtime/cleartusk.db
CLEARTUSK_DATABASE_ECHO=false

# --- Locations (defaults derive from the project root) ---
# CLEARTUSK_DATA_DIR=/var/lib/cleartusk/data
# CLEARTUSK_CORPUS_DIR=/var/lib/cleartusk/data/corpus
# CLEARTUSK_RUNTIME_DIR=/var/lib/cleartusk/runtime

# --- Uploads ---
CLEARTUSK_MAX_UPLOAD_MB=64
CLEARTUSK_ALLOWED_EXTENSIONS=.wav,.mp3,.flac,.ogg,.m4a
CLEARTUSK_RETAIN_RUN_ARTIFACTS=200

# --- Signal processing ---
CLEARTUSK_SAMPLE_RATE=2000
CLEARTUSK_PLAYBACK_SAMPLE_RATE=16000

# --- Detector ---
CLEARTUSK_DETECTOR_WINDOW_SECONDS=1.5
CLEARTUSK_DETECTOR_HOP_SECONDS=0.25
CLEARTUSK_DETECTOR_THRESHOLD=0.6
